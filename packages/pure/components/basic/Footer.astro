---
import config from 'virtual:config'

import { Icon } from '../user'

const footerConf = config.footer
let social = footerConf.social || {}

// If the list does not contain rss, add it
if (!social.rss)
  social.rss = {
    label: 'RSS',
    url: '/rss.xml'
  }

const footerLink1 = footerConf.links?.filter(({ pos }) => pos === 1) || []
---

<footer class='mx-auto mb-5 mt-16 w-full'>
  <div class='border-t pt-5'>
    <div class='flex items-center gap-y-3 max-sm:flex-col sm:justify-between sm:gap-y-0'>
      <div class='flex items-center gap-x-4 gap-y-2 text-muted-foreground max-sm:flex-col'>
        { /* Position 1 */
          footerLink1.length > 0 && (
            <div>
              {footerLink1.map(({ title, link, style }, index) => (
                <>
                  <!- prettier-ignore -->
                  <a href={link} target='_blank' class={style}>{title}</a>
                  {index < footerLink1.length - 1 && <span class='mx-1'>•</span>}
                </>
              ))}
            </div>
          )
        }
        {/* Position 2 */}
        <div class='flex flex-col items-start gap-y-1'>
          <div>
            {config.footer.year}
            {config.author}
            {
              footerConf.links && footerConf.links.length > 0 && (
                <>
                  &
                  <span>
                    {footerConf.links
                      .filter(({ pos }) => pos === 2)
                      .map(({ title, link, style }) => (
                        <span>
                          <a href={link} target='_blank' class={style}>{title}</a>
                        </span>
                      ))}
                  </span>
                </>
              )
            }
          </div>
          <div id='site-runtime' class='text-sm' aria-live='polite'>本站已经运行中...</div>
        </div>
        {
          footerConf.credits && (
            <span>
              <a href='https://github.com/withastro/astro' target='_blank'>Astro</a>
              &
              <a href='https://github.com/cworld1/astro-theme-pure' target='_blank'>Pure</a>
              theme powered
            </span>
          )
        }
      </div>

      {/* Social Brands */}
      <div class='flex items-center gap-x-4'>
        {
          footerConf.social &&
            Object.entries(footerConf.social).map(([platform, { label, url }]) => (
              <a href={url} aria-label={label}>
                <Icon name={platform as keyof typeof footerConf.social} />
              </a>
            ))
        }
      </div>
    </div>
  </div>
</footer>

<script>
  // 从第一篇博客文章《我的第一篇博客文章》的发布日期开始计算
  const siteStartTime = new Date('2025-03-31T00:00:00+08:00')
  const milliseconds = {
    second: 1000,
    minute: 60 * 1000,
    hour: 60 * 60 * 1000,
    day: 24 * 60 * 60 * 1000
  }

  const getRuntime = (now: Date) => {
    let years = now.getFullYear() - siteStartTime.getFullYear()
    const yearCursor = new Date(siteStartTime)
    yearCursor.setFullYear(siteStartTime.getFullYear() + years)
    if (yearCursor > now) years -= 1

    let months = (now.getFullYear() - siteStartTime.getFullYear()) * 12 + now.getMonth() - siteStartTime.getMonth() - years * 12
    const monthCursor = new Date(siteStartTime)
    monthCursor.setFullYear(siteStartTime.getFullYear() + years)
    monthCursor.setMonth(siteStartTime.getMonth() + months)
    if (monthCursor > now) months -= 1

    const cursor = new Date(siteStartTime)
    cursor.setFullYear(siteStartTime.getFullYear() + years)
    cursor.setMonth(siteStartTime.getMonth() + months)

    let remaining = Math.max(0, now.getTime() - cursor.getTime())
    const days = Math.floor(remaining / milliseconds.day)
    remaining -= days * milliseconds.day
    const hours = Math.floor(remaining / milliseconds.hour)
    remaining -= hours * milliseconds.hour
    const minutes = Math.floor(remaining / milliseconds.minute)
    remaining -= minutes * milliseconds.minute
    const seconds = Math.floor(remaining / milliseconds.second)

    return `${years}年${months}个月${days}天${hours}时${minutes}分${seconds}秒`
  }

  const updateSiteRuntime = () => {
    const runtime = document.getElementById('site-runtime')
    if (runtime) runtime.textContent = `本站已经运行${getRuntime(new Date())}`
  }

  updateSiteRuntime()
  setInterval(updateSiteRuntime, 1000)
</script>

<style>
  footer a {
    color: hsl(var(--foreground) / var(--un-text-opacity, 1));
    text-decoration: underline;
    font-weight: 500;
  }
</style>
