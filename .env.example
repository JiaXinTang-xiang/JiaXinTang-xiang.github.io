# Umami analytics
# Cloud: https://analytics.umami.is/script.js
# Self-hosted: https://your-umami-domain.example/script.js
PUBLIC_UMAMI_SCRIPT_URL=
PUBLIC_UMAMI_WEBSITE_ID=

# 看板娘 AI 对话（服务端专用，不要加 PUBLIC_ 前缀）
# 密钥只在这里出现，前端拿不到；本地复制成 .env，Vercel 在项目设置里各加一条同名的环境变量
#
# Agnes 国际站控制台：https://platform.agnes-ai.com
# 注意中国站 https://platform.agnes-ai.cn 是另一套 key，两边不通用
AI_API_KEY=
# 可选，默认 agnes-3.0-flash（当前免费）；agnes-2.5-pro 是 $0.45/$0.90 每 M token
AI_MODEL=
# 可选，默认 https://apihub.agnes-ai.com/v1
AI_BASE_URL=
