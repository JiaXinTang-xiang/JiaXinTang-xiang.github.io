<div id='ai-chat' hidden>
  <header id='ai-chat-head'>
    <span id='ai-chat-title'>和小蓝聊聊</span>
    <button type='button' id='ai-chat-close' aria-label='收起对话'>✕</button>
  </header>
  <div id='ai-chat-log' role='log' aria-live='polite' aria-label='对话记录'></div>
  <form id='ai-chat-form'>
    <input
      id='ai-chat-input'
      type='text'
      autocomplete='off'
      maxlength='600'
      placeholder='说点什么…'
      aria-label='输入消息'
    />
    <button type='submit' id='ai-chat-send'>发送</button>
  </form>
</div>

<script is:inline>
  ;(() => {
    const panel = document.getElementById('ai-chat')
    const log = document.getElementById('ai-chat-log')
    const form = document.getElementById('ai-chat-form')
    const input = document.getElementById('ai-chat-input')
    const sendButton = document.getElementById('ai-chat-send')

    if (!panel || !log || !form || !input || !sendButton) return

    const GREETING =
      '唔……你好呀，我是这个博客的看板娘小蓝。想聊技术、翻文章，或者随便说说话都可以～'

    // 只保留最近若干条，服务端还会再截一次
    const HISTORY_LIMIT = 20
    const history = []
    let sending = false
    let greeted = false

    // 一律用 textContent：AI 的回复来自外部，不能当 HTML 插进来
    const bubble = (role, text) => {
      const item = document.createElement('div')
      item.className = `ai-chat-bubble ai-chat-${role}`
      item.textContent = text
      log.appendChild(item)
      log.scrollTop = log.scrollHeight
      return item
    }

    const setBusy = (busy) => {
      sending = busy
      sendButton.disabled = busy
      input.disabled = busy
      sendButton.textContent = busy ? '…' : '发送'
    }

    const openPanel = () => {
      panel.hidden = false
      if (!greeted) {
        greeted = true
        bubble('assistant', GREETING)
      }
      input.focus()
    }

    const closePanel = () => {
      panel.hidden = true
    }

    const send = async (text) => {
      history.push({ role: 'user', content: text })
      if (history.length > HISTORY_LIMIT) history.splice(0, history.length - HISTORY_LIMIT)
      bubble('user', text)
      setBusy(true)

      const pending = bubble('assistant ai-chat-pending', '……')

      try {
        // 站点是 trailingSlash: 'always'，带斜杠能直接命中路由，省一次 308 跳转
        const response = await fetch('/api/chat/', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ messages: history })
        })
        const data = await response.json().catch(() => null)

        if (!response.ok || typeof data?.reply !== 'string') {
          pending.remove()
          bubble('assistant ai-chat-error', data?.error || '我这边出了点问题，稍后再试试吧。')
          return
        }

        pending.textContent = data.reply
        pending.className = 'ai-chat-bubble ai-chat-assistant'
        history.push({ role: 'assistant', content: data.reply })
        if (history.length > HISTORY_LIMIT) history.splice(0, history.length - HISTORY_LIMIT)
        log.scrollTop = log.scrollHeight
      } catch (error) {
        console.error('[ai-chat] 请求失败', error)
        pending.remove()
        bubble('assistant ai-chat-error', '网络好像不太顺，稍后再试试吧。')
      } finally {
        setBusy(false)
        if (!panel.hidden) input.focus()
      }
    }

    // 点看板娘开合对话面板（事件由 Live2DWidget 派发）
    document.addEventListener('live2d:tap', () => {
      if (panel.hidden) openPanel()
      else closePanel()
    })

    document.getElementById('ai-chat-close')?.addEventListener('click', closePanel)

    form.addEventListener('submit', (event) => {
      event.preventDefault()
      const text = input.value.trim()
      if (!text || sending) return
      input.value = ''
      send(text)
    })
  })()
</script>

<style is:global>
  #ai-chat {
    position: fixed;
    bottom: 14px;
    left: 288px;
    z-index: 41;
    display: flex;
    flex-direction: column;
    width: 340px;
    height: 380px;
    overflow: hidden;
    border: 1px solid hsl(var(--border));
    border-radius: calc(var(--radius) + 4px);
    background: hsl(var(--background) / 95%);
    box-shadow: 0 12px 32px rgb(0 0 0 / 18%);
    color: hsl(var(--foreground));
    font-size: 13px;
    line-height: 1.55;
    backdrop-filter: blur(10px);
  }

  #ai-chat[hidden] {
    display: none;
  }

  #ai-chat-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 12px;
    border-bottom: 1px solid hsl(var(--border));
    background: hsl(var(--muted) / 60%);
    font-weight: 600;
  }

  #ai-chat-close {
    border: 0;
    background: transparent;
    color: hsl(var(--muted-foreground));
    cursor: pointer;
    font-size: 14px;
    line-height: 1;
    padding: 4px 6px;
    border-radius: 6px;
  }

  #ai-chat-close:hover {
    background: hsl(var(--muted));
    color: hsl(var(--foreground));
  }

  #ai-chat-log {
    flex: 1;
    overflow-y: auto;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    overscroll-behavior: contain;
  }

  .ai-chat-bubble {
    max-width: 86%;
    padding: 7px 10px;
    border-radius: 12px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .ai-chat-user {
    align-self: flex-end;
    background: hsl(var(--primary) / 18%);
    border: 1px solid hsl(var(--primary) / 30%);
  }

  .ai-chat-assistant {
    align-self: flex-start;
    background: hsl(var(--muted));
  }

  .ai-chat-pending {
    align-self: flex-start;
    background: hsl(var(--muted));
    color: hsl(var(--muted-foreground));
  }

  .ai-chat-error {
    align-self: flex-start;
    background: hsl(0 80% 60% / 12%);
    border: 1px solid hsl(0 80% 60% / 30%);
    color: hsl(0 70% 45%);
    font-size: 12px;
  }

  #ai-chat-form {
    display: flex;
    gap: 6px;
    padding: 9px 10px;
    border-top: 1px solid hsl(var(--border));
    background: hsl(var(--muted) / 40%);
  }

  #ai-chat-input {
    flex: 1;
    min-width: 0;
    padding: 7px 10px;
    border: 1px solid hsl(var(--input));
    border-radius: 8px;
    background: hsl(var(--background));
    color: hsl(var(--foreground));
    font: inherit;
  }

  #ai-chat-input:focus {
    outline: 2px solid hsl(var(--ring) / 25%);
    outline-offset: 0;
  }

  #ai-chat-send {
    flex: none;
    padding: 7px 14px;
    border: 0;
    border-radius: 8px;
    background: hsl(var(--primary) / 90%);
    color: hsl(var(--background));
    cursor: pointer;
    font: inherit;
    font-weight: 600;
  }

  #ai-chat-send:disabled {
    cursor: default;
    opacity: 0.6;
  }

  @media (max-width: 767px) {
    #ai-chat {
      left: 8px;
      right: 8px;
      bottom: 258px;
      width: auto;
      height: 300px;
    }
  }
</style>
