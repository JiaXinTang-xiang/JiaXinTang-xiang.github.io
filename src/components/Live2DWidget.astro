<div id='live2d-widget' role='button' tabindex='0' aria-label='嘉心糖看板娘，按回车打开对话框'>
  <canvas id='live2d-canvas'></canvas>
  <p id='live2d-status' role='status'>模型加载中…</p>
</div>

<script is:inline src='https://cubism.live2d.com/sdk-web/cubismcore/live2dcubismcore.min.js'
></script>
<script is:inline src='https://cdn.jsdelivr.net/npm/pixi.js@7.x/dist/pixi.min.js'></script>
<script is:inline src='https://cdn.jsdelivr.net/npm/pixi-live2d-display/dist/cubism4.min.js'
></script>

<script is:inline>
  ;(() => {
    const container = document.getElementById('live2d-widget')
    const canvas = document.getElementById('live2d-canvas')
    const status = document.getElementById('live2d-status')

    if (!container || !canvas || container.dataset.initialized === 'true') return
    container.dataset.initialized = 'true'

    // 对话入口先注册，而且不依赖模型：CDN 被墙、不支持 WebGL、模型 404 的时候，
    // 下面 start() 会直接返回，但对话框仍然要能打开，否则就等于没有入口了。
    const openChat = () => container.dispatchEvent(new CustomEvent('live2d:tap', { bubbles: true }))

    container.addEventListener('click', openChat)

    // 键盘也要能用：容器是个 role=button 的 div，得自己处理 Enter / 空格
    container.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return
      event.preventDefault()
      openChat()
    })

    const showError = (message, error) => {
      console.error(`[Live2D] ${message}`, error)
      if (!status) return

      status.textContent = message
      status.dataset.error = 'true'

      // 模型没加载出来时画面上没有角色可点，给一个看得见的按钮兜底
      if (status.querySelector('button')) return
      const fallback = document.createElement('button')
      fallback.type = 'button'
      fallback.textContent = '打开对话框'
      fallback.addEventListener('click', (event) => {
        // 别让事件冒泡到 container 再触发一次，否则会连说两句
        event.stopPropagation()
        openChat()
      })
      status.appendChild(fallback)
    }

    // 留出一点余量，避免头发/肢体的物理摆动被容器边缘切掉
    const FIT_RATIO = 0.96

    // 导出的模型画布比角色本身大得多（角色只占中间一条），所以画布中心并不是角色中心。
    // 这里直接量取实际轮廓：模型空间两轴都是 [-0.5, 0.5]，对应整张画布。
    const measureContent = (model) => {
      const { coreModel, originalWidth: w, originalHeight: h } = model.internalModel
      let minX = Infinity
      let minY = Infinity
      let maxX = -Infinity
      let maxY = -Infinity

      for (let i = 0; i < coreModel.getDrawableCount(); i += 1) {
        if (coreModel.getDrawableOpacity(i) <= 0) continue
        const positions = coreModel.getDrawableVertexPositions(i)
        for (let k = 0; k < positions.length; k += 2) {
          minX = Math.min(minX, positions[k])
          maxX = Math.max(maxX, positions[k])
          minY = Math.min(minY, positions[k + 1])
          maxY = Math.max(maxY, positions[k + 1])
        }
      }

      if (!Number.isFinite(minX + minY + maxX + maxY) || maxX <= minX || maxY <= minY) {
        return { left: 0, top: 0, width: w, height: h }
      }

      return {
        left: (minX + 0.5) * w,
        top: (0.5 - maxY) * h,
        width: (maxX - minX) * w,
        height: (maxY - minY) * h
      }
    }

    // 模型自带的表情与动作（见 seethrough_output.model3.json）
    const EXPRESSIONS = ['微笑', '惊讶', '半闭眼', '嫌弃眼', '左眼眨', '右眼眨']
    const NEUTRAL = '普通'
    const MOTIONS = ['Nod', 'Shake', 'Blink']

    const pick = (list) => list[Math.floor(Math.random() * list.length)]
    const wait = (ms) => new Promise((resolve) => setTimeout(resolve, ms))

    // 把量到的轮廓等比缩放到容器内并居中，anchor 取 (0,0) 即画布左上角
    const fitContent = (model, content) => {
      const width = container.clientWidth
      const height = container.clientHeight
      const scale = Math.min(width / content.width, height / content.height) * FIT_RATIO

      model.scale.set(scale)
      model.anchor.set(0, 0)
      model.x = (width - content.width * scale) / 2 - content.left * scale
      model.y = (height - content.height * scale) / 2 - content.top * scale
    }

    const start = async () => {
      const PIXI = window.PIXI
      const Live2DModel = PIXI?.live2d?.Live2DModel

      if (!PIXI || !Live2DModel) {
        showError('Live2D 运行库加载失败，请检查网络连接。')
        return
      }

      const width = container.clientWidth
      const height = container.clientHeight
      const app = new PIXI.Application({
        view: canvas,
        width,
        height,
        backgroundAlpha: 0,
        antialias: true,
        autoDensity: true,
        resolution: Math.min(window.devicePixelRatio || 1, 2)
      })

      try {
        const model = await Live2DModel.from(
          '/live2d/seethrough_output/seethrough_output.model3.json',
          { autoInteract: false }
        )

        app.stage.addChild(model)

        // 等框架把模型摆到第一帧姿态后再量轮廓，否则顶点还没计算出来
        await new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)))

        const content = measureContent(model)
        fitContent(model, content)

        if (status) status.remove()

        // 鼠标不在页面上时自己找事做：随机换表情、偶尔配个动作
        let idleActing = false

        const idleRoutine = async () => {
          while (idleActing) {
            await wait(5000 + Math.random() * 6000)
            if (!idleActing) return
            model.expression(pick(EXPRESSIONS))
            if (Math.random() < 0.5) model.motion(pick(MOTIONS))
            await wait(2500 + Math.random() * 2000)
            if (!idleActing) return
            model.expression(NEUTRAL)
          }
        }

        const startIdleActing = () => {
          if (idleActing) return
          idleActing = true
          idleRoutine()
        }

        // 鼠标一回到页面上就收手，把嘴巴交还给下面的微张逻辑
        const stopIdleActing = () => {
          if (!idleActing) return
          idleActing = false
          model.expression(NEUTRAL)
        }

        // 鼠标在页面上时让嘴保持微张，嘴型一直看得见；离开页面才交回给待机表情。
        // 模型的嘴只有一条 28x3px 的网格，靠 ParamMouthOpenY 撑开才看得见。
        // 每帧在 beforeModelUpdate 里写：这是形变计算前的最后一步，写完立刻 model.update()，
        // 不会像表达式那样在末尾被 loadParameters() 还原掉。
        const MOUTH_OPEN = 0.5
        const coreModel = model.internalModel.coreModel
        let mouthTarget = MOUTH_OPEN
        let mouthValue = 0

        model.internalModel.on('beforeModelUpdate', () => {
          mouthValue += (mouthTarget - mouthValue) * 0.12
          if (mouthValue > 0.001) coreModel.setParameterValueById('ParamMouthOpenY', mouthValue)
        })

        const startTracking = () => {
          mouthTarget = MOUTH_OPEN
          stopIdleActing()
        }

        // 挂在 window 上而不是看板娘容器上：focus() 只取指针相对模型的方向，
        // 所以鼠标在整页任意位置都能让模型看过去，坐标超出画布也没关系。
        window.addEventListener('pointermove', (event) => {
          startTracking()
          const rect = canvas.getBoundingClientRect()
          model.focus(event.clientX - rect.left, event.clientY - rect.top)
        })

        // 视线归位。别用 model.focus(容器中心)：focus() 是按「画布左上角 -> 目标点」算方向的，
        // 传容器中心会算出一个歪向一边的角度，脑袋会一直歪着、甚至整个偏出画布。
        const resetGaze = () => model.internalModel.focusController?.focus(0, 0)

        // 指针离开整个页面：视线回到正前方，嘴巴合上，然后自己动起来
        document.addEventListener('mouseleave', () => {
          mouthTarget = 0
          startIdleActing()
          resetGaze()
        })

        // 点击时的动作反应。开对话面板那件事由上面那个不依赖模型的监听负责，
        // 这里不要再派发一次 live2d:tap，否则一次点击会说两句。
        container.addEventListener('click', () => {
          model.motion(pick(MOTIONS))
          model.expression(pick(EXPRESSIONS))
        })

        // 让动作跟着对话走：Live2DChat 用这个事件点名要哪个表情 / 动作。
        // 只认白名单里的名字，避免外面塞个乱七八糟的值进来。
        container.addEventListener('live2d:react', (event) => {
          const { expression, motion } = event.detail || {}
          stopIdleActing()
          if (expression === NEUTRAL || EXPRESSIONS.includes(expression))
            model.expression(expression)
          if (MOTIONS.includes(motion)) model.motion(motion)
        })

        window.addEventListener('resize', () => {
          app.renderer.resize(container.clientWidth, container.clientHeight)
          fitContent(model, content)
        })
      } catch (error) {
        showError('模型加载失败，请打开控制台查看详细信息。', error)
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start, { once: true })
    } else {
      start()
    }
  })()
</script>

<style>
  #live2d-widget {
    position: fixed;
    bottom: 0;
    left: 0;
    z-index: 40;
    width: 280px;
    height: 380px;
    overflow: hidden;
    cursor: pointer;
    pointer-events: auto;
  }

  #live2d-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  #live2d-status {
    position: absolute;
    bottom: 14px;
    left: 14px;
    max-width: 240px;
    margin: 0;
    padding: 7px 10px;
    border: 1px solid rgb(255 255 255 / 45%);
    border-radius: 10px;
    background: rgb(20 20 25 / 72%);
    color: white;
    font-size: 12px;
    line-height: 1.4;
    backdrop-filter: blur(8px);
  }

  #live2d-status[data-error='true'] {
    color: #fecaca;
  }

  /* 模型没加载出来时的兜底按钮 */
  #live2d-status button {
    display: block;
    margin-top: 8px;
    padding: 4px 10px;
    border: 1px solid rgb(255 255 255 / 55%);
    border-radius: 8px;
    background: rgb(255 255 255 / 12%);
    color: white;
    cursor: pointer;
    font: inherit;
  }

  #live2d-status button:hover {
    background: rgb(255 255 255 / 22%);
  }

  #live2d-widget:focus-visible {
    outline: 2px solid hsl(var(--primary) / 65%);
    outline-offset: -2px;
    border-radius: 12px;
  }

  @media (max-width: 767px) {
    #live2d-widget {
      width: 180px;
      height: 250px;
      left: -8px;
    }
  }
</style>
