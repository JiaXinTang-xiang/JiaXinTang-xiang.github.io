---
import type { MarkdownHeading } from 'astro'
import type { CollectionEntry } from 'astro:content'

// Plugin styles
import 'katex/dist/katex.min.css'

import { MediumZoom } from 'astro-pure/advanced'
import { Copyright, Hero, TOC } from 'astro-pure/components/pages'
import ArticleNav from '@/components/ArticleNav.astro'
import Mermaid from '@/components/Mermaid.astro'
import config from 'virtual:config'
import { ogImage } from '@/site-config'
import PageLayout from '@/layouts/ContentLayout.astro'
import { Comment, PageInfo } from '@/components/waline'
import PasswordGate from '@/components/PasswordGate.astro'

interface Props {
  post: CollectionEntry<'blog' | 'tech' | 'daily' | 'monthly'>
  posts: CollectionEntry<'blog' | 'tech' | 'daily' | 'monthly'>[]
  headings: MarkdownHeading[]
  remarkPluginFrontmatter: Record<string, unknown>
}

const {
  post: { id, data, collection },
  posts,
  headings,
  remarkPluginFrontmatter
} = Astro.props

const {
  description,
  title,
  draft
} = data

const meta = {
  title: `${title} • ${config.author}`,
  description,
  image: config.socialCard,
  // 每篇文章的 1200×630 社交预览图，由 src/pages/og/[...slug].png.ts 构建时生成
  ...(ogImage.enable && { ogImage: `/og/${collection}/${id}.png` })
}

const isDraft = Boolean(draft)
const enableComment = data.comment !== false

const back = `/${collection}`
---

<PageLayout {meta} back={back}>
  <Hero {data} {remarkPluginFrontmatter}>
    <Fragment slot='description'>
      {!isDraft && enableComment && <PageInfo comment class='mt-1' />}
    </Fragment>
  </Hero>

  <PasswordGate password={data.password}>
    <slot />
  </PasswordGate>

  <Fragment slot='bottom'>
    <ArticleNav id={id} collection={collection} collections={posts} class='mb-6' />
    <Copyright {data} />
    {!isDraft && enableComment && <Comment class='mt-3 sm:mt-6' />}
  </Fragment>

  <Fragment slot='sidebar'>
    <TOC {headings} />
  </Fragment>
</PageLayout>

{config.integ.mediumZoom.enable && <MediumZoom />}

{/* mermaid 图表：仅在页面含 .mermaid 容器时才真正加载脚本 */}
<Mermaid />
