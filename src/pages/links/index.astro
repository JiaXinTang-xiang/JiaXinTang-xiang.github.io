---
import links from 'public/links.json'

// import { Collapse, Timeline } from 'astro-pure/user' // 暂时注释掉未使用的导入
import config from 'virtual:config'
import PageLayout from '@/layouts/CommonPage.astro'
import FriendList from '@/components/links/FriendList.astro'
import { collectFriendsActivity } from '@/utils/friends-feed'

const headings = [
  { depth: 2, slug: 'common-links', text: 'Common Links' },
  { depth: 2, slug: 'blog-links', text: 'Blog Links' },
  { depth: 2, slug: 'apply-links', text: 'Apply Links' },
  { depth: 2, slug: 'friends-activity', text: 'Friends Activity' }
]

const { friends } = links
const linksConf = config.integ.links
const linkEditPage = 'https://github.com/jiaxintang-xiang/JIABlog/blob/main/public/links.json'
const friendSites = friends[0]?.link_list ?? []
const { items: allFriendActivity, sources: friendFeedSources } = await collectFriendsActivity(friendSites)
const oneMonthAgo = new Date()
oneMonthAgo.setMonth(oneMonthAgo.getMonth() - 1)
const friendActivity = allFriendActivity.filter((article) => new Date(article.publishedAt) >= oneMonthAgo)
const activeFriendFeeds = friendFeedSources.filter((source) => source.status === 'ok').length
const initialVisibleItems = 5
const loadMoreItems = 5
---

<PageLayout title='Links' {headings} comment>
  <p>They're sorted randomly.</p>
  <h2 id='common-links' data-i18n='links.common'>Common Links</h2>
  <FriendList list={friends[0]} />
  <h2 id='blog-links'>博客链接</h2>
  <p>独立博客传送门、博客社区等链接</p>
  <FriendList list={friends[2]} />
  <!-- <Collapse title='Links with Bad Status'>
    <FriendList list={friends[1]} />
  </Collapse>
  <Collapse title='Link History Book'>
    <Timeline events={linksConf.logbook} />
  </Collapse> -->

  <h2 id='apply-links' data-i18n='links.apply'>Apply Links</h2>
  <p>本站信息（点击复制）The site information (click to copy)：</p>
  <blockquote class='not-prose grid grid-cols-[auto_1fr] gap-x-2 break-words border-s-4 ps-4'>
    {
      linksConf.applyTip.map(({ name, val }) => {
        const script = `navigator.clipboard.writeText('${val}');document.dispatchEvent(new CustomEvent('toast',{detail:{message:'Copied "${val}" to clipboard!'}}))`
        return (
          <>
            <span class='text-end'>{name}:</span>
            <samp class='cursor-pointer' onclick={script}>
              {val}
            </samp>
          </>
        )
      })
    }
  </blockquote>

  <div class="my-6 rounded-xl bg-slate-50 dark:bg-slate-800/50 p-5 shadow-sm border border-slate-200 dark:border-slate-700">
  <p class="text-base md:text-lg text-slate-700 dark:text-slate-300 leading-relaxed">
    可通过下方留言或 <a href={linkEditPage} target="_blank" class="font-medium text-blue-600 dark:text-blue-400 hover:underline">提交 PR</a> 申请友链。
    <span class="text-sm text-slate-500 dark:text-slate-400">申请说明：</span>
  </p>
  <p class="mt-1 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
    Apply via comment or <a href={linkEditPage} target="_blank" class="font-medium text-blue-600 dark:text-blue-400 hover:underline">submitting a PR</a>.
    Requirements:
  </p>

  <ul class="mt-4 space-y-2 pl-1">
    <li class="flex items-start gap-2 text-slate-700 dark:text-slate-300">
      <span class="text-green-500 mt-0.5">✅</span>
      已在你的友链中添加本站
      <span class="text-slate-500 dark:text-slate-400 ml-1">Add our link first</span>
    </li>
    <li class="flex items-start gap-2 text-slate-700 dark:text-slate-300">
      <span class="text-green-500 mt-0.5">✅</span>
      站点可正常访问 + 拥有独立域名
      <span class="text-slate-500 dark:text-slate-400 ml-1">Site alive + valid domain</span>
    </li>
    <li class="flex items-start gap-2 text-slate-700 dark:text-slate-300">
      <span class="text-green-500 mt-0.5">✅</span>
      内容合法合规，无违规信息
      <span class="text-slate-500 dark:text-slate-400 ml-1">Legal & friendly content</span>
    </li>
  </ul>
</div>

  <section class='mt-10' aria-labelledby='friends-activity'>
    <div class='mb-5'>
      <h2 id='friends-activity' class='mb-1'>朋友动态</h2>
      <p class='m-0 text-muted-foreground'>最新动态 · 看看朋友们都在写什么</p>
    </div>

    {
      friendActivity.length > 0 ? (
        <>
          <div class='mb-4 text-sm text-muted-foreground'>
            已汇总 {activeFriendFeeds} 个友链博客，共 {friendActivity.length} 篇最近文章。
          </div>
          <div class='grid gap-4 md:grid-cols-2' data-friends-activity-list>
            {friendActivity.map((article, index) => (
              <article
                class='flex h-full flex-col rounded-xl border bg-background p-4 transition-colors hover:bg-muted'
                data-friends-activity-item
                hidden={index >= initialVisibleItems}
              >
                <div class='mb-3 flex items-center gap-2 text-xs text-muted-foreground'>
                  <img
                    src={article.avatar}
                    alt=''
                    width='24'
                    height='24'
                    loading='lazy'
                    class='size-6 rounded-full object-cover'
                  />
                  <span>{article.sourceName}</span>
                  <span aria-hidden='true'>·</span>
                  <time datetime={article.publishedAt}>
                    {new Date(article.publishedAt).toLocaleDateString('zh-CN')}
                  </time>
                </div>
                <a
                  href={article.link}
                  target='_blank'
                  rel='noopener noreferrer'
                  class='text-base font-medium text-foreground no-underline hover:text-primary'
                >
                  {article.title}
                </a>
                {article.description && (
                  <p class='mt-2 line-clamp-2 text-sm text-muted-foreground'>{article.description}</p>
                )}
              </article>
            ))}
          </div>
          {friendActivity.length > initialVisibleItems && (
            <>
              <button
                type='button'
                class='mx-auto mt-5 block rounded-lg border px-4 py-2 text-sm transition-colors hover:bg-muted'
                data-friends-load-more
                data-step={loadMoreItems}
                data-total={friendActivity.length}
              >
                加载更多
              </button>
              <div data-friends-load-sentinel aria-hidden='true' class='h-1' />
            </>
          )}
        </>
      ) : (
        <p class='rounded-xl border border-dashed p-5 text-sm text-muted-foreground'>
          最近一个月暂时没有抓取到友链文章。
        </p>
      )
    }

    <p class='mt-4 rounded-xl bg-muted/50 p-4 text-sm text-muted-foreground'>
      💡 在友链但是没有找到你的文章？请为你的博客添加 RSS 吧~
    </p>
  </section>


  <!-- <p>
    可通过下方留言或 <a href={linkEditPage} target='_blank'>提交 PR</a> 申请友链。申请说明：<br />
    Apply your link by leaving comment or <a href={linkEditPage} target='_blank'>Submitting a PR</a
    >. Additional info:
  </p>
  <ul>
    <li>在你的友链上推荐了本站 You've recommended our link on your website</li>
    <li>站点活着且有正式域名 Make sure your site is alive with a formal domain</li>
    <li>内容不违反国家法律 Content does not violate laws</li>
  </ul> -->



</PageLayout>

<script>
  const loadMoreButton = document.querySelector<HTMLButtonElement>('[data-friends-load-more]')
  const loadMoreSentinel = document.querySelector<HTMLElement>('[data-friends-load-sentinel]')
  const activityItems = Array.from(document.querySelectorAll<HTMLElement>('[data-friends-activity-item]'))

  const revealMoreItems = () => {
    if (!loadMoreButton) return
    const step = Number(loadMoreButton.dataset.step) || 5
    const hiddenItems = activityItems.filter((item) => item.hidden)

    hiddenItems.slice(0, step).forEach((item) => {
      item.hidden = false
    })

    if (!activityItems.some((item) => item.hidden)) {
      loadMoreButton.hidden = true
      loadMoreObserver?.disconnect()
    }
  }

  loadMoreButton?.addEventListener('click', revealMoreItems)

  const loadMoreObserver = loadMoreSentinel && 'IntersectionObserver' in window
    ? new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) revealMoreItems()
      }, { rootMargin: '240px' })
    : undefined

  if (loadMoreSentinel) loadMoreObserver?.observe(loadMoreSentinel)
</script>
