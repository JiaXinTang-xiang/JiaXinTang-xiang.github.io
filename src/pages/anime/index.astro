---
import LeisurePage from '../../layouts/LeisurePage.astro'
import { anime } from '../../data/leisure'
const statuses = ['在看', '看完', '想看'] as const
---

<LeisurePage title='追番' description='在别人的故事里，遇见一些热爱。记录我看的番剧。' active='anime'>
  <div class='summary'>
    <span>我的片单 · {anime.length} 部</span>
    <span>{statuses.map(status => `${status} ${anime.filter(item => item.status === status).length}`).join(' / ')}</span>
  </div>
  <div class='anime-grid'>
    {anime.map((item, index) => (
      <article class='anime-card'>
        <div class:list={['cover', { alternate: index % 2 === 1, poster: !!item.cover }]}>
          {item.cover ? <img src={item.cover} alt={`${item.title}封面`} loading='lazy' referrerpolicy='no-referrer' width='660' height='884' /> : (
            <div class='typographic-cover' aria-hidden='true'>
              <span class='cover-label'>我的追番手记</span>
              <span class='cover-title'>{item.title}</span>
              <span class='cover-number'>WATCHLIST / {String(index + 1).padStart(2, '0')}</span>
            </div>
          )}
          <span class='status'>{item.status}</span>
        </div>
        <div class='details'>
          <h2>{item.title}</h2>
          {item.progress && <p class='progress'>{item.progress}</p>}
          {item.note && <p class='note'>{item.note}</p>}
          {item.url && <a href={item.url} target='_blank' rel='noopener noreferrer'>去看看 ↗</a>}
        </div>
      </article>
    ))}
  </div>
</LeisurePage>

<style>
  .summary { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.2rem; font-size: .8rem; color: hsl(var(--muted-foreground)); }
  .anime-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .anime-card { overflow: hidden; border: 1px solid hsl(var(--border)); border-radius: 1rem; background: hsl(var(--background)); }
  .cover { position: relative; aspect-ratio: 4 / 3; background: radial-gradient(ellipse at 85% 100%, #93aaa080, transparent 60%), linear-gradient(135deg, #203d3c, #527063); color: #f4f2e9; overflow: hidden; }
  .cover.alternate { background: radial-gradient(ellipse at 85% 10%, #b7a5cc66, transparent 60%), linear-gradient(135deg, #30344c, #6a6079); }
  .cover.poster { aspect-ratio: 3 / 4; }
  .cover img { width: 100%; height: 100%; object-fit: contain; }
  .typographic-cover { height: 100%; display: flex; flex-direction: column; justify-content: space-between; padding: 1.7rem; }
  .cover-label, .cover-number { font-size: .65rem; letter-spacing: .16em; opacity: .7; }
  .cover-title { font-family: 'LXGW WenKai', serif; font-size: clamp(1.7rem, 4vw, 2.8rem); letter-spacing: .12em; }
  .status { position: absolute; right: 1rem; top: 1rem; border: 1px solid #ffffff40; border-radius: 2rem; padding: .2rem .65rem; background: #00000030; font-size: .7rem; }
  .details { padding: 1.3rem 1.5rem; }
  h2 { font-size: 1.15rem; font-weight: 600; }
  .progress, .note { margin-top: .6rem; font-size: .85rem; line-height: 1.8; color: hsl(var(--muted-foreground)); }
  .details a { display: inline-block; margin-top: .8rem; font-size: .8rem; color: hsl(var(--primary)); }
  @media (max-width: 540px) { .anime-grid { grid-template-columns: 1fr; } }
</style>
