<style>
  .hero-intro {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 100svh;
    width: 100%;
    overflow: hidden;
    place-items: center;
    background: #f8fbff;
    color: #142033;
    cursor: default;
    transition: filter 650ms ease, opacity 650ms ease;
  }

  .hero-intro::before {
    position: absolute;
    inset: 0;
    z-index: -3;
    background:
      radial-gradient(circle at 18% 18%, rgb(174 224 255 / 35%), transparent 28%),
      radial-gradient(circle at 80% 80%, rgb(132 182 255 / 25%), transparent 32%),
      linear-gradient(135deg, #fafdff 0%, #eef7ff 52%, #fdfcff 100%);
    content: '';
  }

  .hero-grid {
    position: absolute;
    inset: -15%;
    z-index: -2;
    opacity: 0.42;
    background-image:
      linear-gradient(rgb(72 131 185 / 11%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(72 131 185 / 11%) 1px, transparent 1px);
    background-size: 64px 64px;
    transform: perspective(700px) rotateX(58deg) translateY(12%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 25%, #000 75%, transparent 100%);
  }

  .hero-glow {
    position: absolute;
    z-index: -1;
    border-radius: 999px;
    filter: blur(8px);
    opacity: 0.7;
    animation: hero-float 9s ease-in-out infinite;
  }

  .hero-glow-one {
    top: 14%;
    left: 12%;
    width: 18rem;
    height: 18rem;
    background: rgb(105 195 255 / 22%);
  }

  .hero-glow-two {
    right: 18%;
    bottom: 8%;
    width: 24rem;
    height: 24rem;
    background: rgb(152 118 255 / 16%);
    animation-delay: -4s;
  }

  .hero-copy {
    z-index: 2;
    width: min(88vw, 36rem);
    margin: 0;
    text-align: center;
    animation: hero-copy-in 1s 0.15s both cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hero-kicker {
    margin: 0 0 1.25rem;
    color: #5f8dab;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.28em;
  }

  .hero-copy h1 {
    margin: 0;
    color: #16263d;
    font-size: clamp(2.7rem, 7vw, 6.2rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.06em;
  }

  .hero-copy h1 em {
    color: #4b9bc9;
    font-style: normal;
  }

  .hero-subtitle {
    margin: 1.5rem 0 2rem;
    color: #617187;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
  }

  .hero-rings {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: -1;
    width: min(82vw, 48rem);
    aspect-ratio: 1;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .hero-rings span {
    position: absolute;
    inset: 14%;
    border: 1px solid rgb(90 169 212 / 24%);
    border-radius: 50%;
    box-shadow: 0 0 45px rgb(108 190 232 / 13%), inset 0 0 35px rgb(108 190 232 / 9%);
    animation: hero-ring 8s ease-in-out infinite;
  }

  .hero-rings span:nth-child(2) { inset: 25%; animation-delay: -2.6s; }
  .hero-rings span:nth-child(3) { inset: 36%; animation-delay: -5.2s; }

  .hero-enter {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    border: 1px solid rgb(77 153 198 / 30%);
    border-radius: 999px;
    padding: 0.8rem 1.15rem 0.8rem 1.35rem;
    background: rgb(255 255 255 / 70%);
    color: #2b6d97;
    box-shadow: 0 12px 35px rgb(53 124 176 / 14%);
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform 220ms ease, box-shadow 220ms ease, background 220ms ease;
  }

  .hero-enter:hover {
    background: #fff;
    box-shadow: 0 16px 42px rgb(53 124 176 / 22%);
    transform: translateY(-3px);
  }

  .hero-enter-arrow {
    display: grid;
    width: 1.7rem;
    height: 1.7rem;
    place-items: center;
    border-radius: 50%;
    background: #4c9bc9;
    color: white;
    font-size: 1rem;
  }

  .hero-character-wrap {
    position: absolute;
    right: clamp(-7rem, 4vw, 4rem);
    bottom: -5rem;
    width: min(57vw, 48rem);
    z-index: -1;
    opacity: 0.28;
    mix-blend-mode: multiply;
    filter: saturate(0.75);
    animation: hero-character-in 1.1s 0.1s both cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hero-character-halo {
    position: absolute;
    inset: 18% 12% 5%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(147 220 255 / 38%), transparent 68%);
    filter: blur(10px);
    animation: hero-breathe 5s ease-in-out infinite;
  }

  .hero-character {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 28px 25px rgb(43 98 145 / 20%));
    animation: hero-breathe 5s ease-in-out infinite;
  }

  .hero-particles {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero-particles span {
    position: absolute;
    top: calc((var(--i) * 37) % 95 * 1%);
    left: calc((var(--i) * 61) % 95 * 1%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #73bce4;
    box-shadow: 0 0 16px 4px rgb(115 188 228 / 45%);
    opacity: 0.55;
    animation: hero-particle 5s calc(var(--i) * -0.3s) ease-in-out infinite;
  }

  .hero-hint {
    position: absolute;
    bottom: 1.7rem;
    left: 50%;
    z-index: 3;
    margin: 0;
    color: #7792a7;
    font-size: 0.76rem;
    letter-spacing: 0.12em;
    transform: translateX(-50%);
  }

  .hero-intro[data-ripple]::after {
    position: absolute;
    top: var(--ripple-y, 50%);
    left: var(--ripple-x, 50%);
    width: 2rem;
    height: 2rem;
    border: 2px solid rgb(94 177 222 / 55%);
    border-radius: 50%;
    content: '';
    pointer-events: none;
    animation: hero-ripple 850ms ease-out forwards;
  }

  .hero-click-spark {
    position: absolute;
    z-index: 8;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #73c4ed;
    box-shadow: 0 0 12px 3px rgb(115 196 237 / 70%);
    pointer-events: none;
    animation: hero-spark 760ms ease-out forwards;
  }

  .hero-hint span {
    display: inline-block;
    margin-left: 0.4rem;
    animation: hero-arrow 1.4s ease-in-out infinite;
  }

  .home-content {
    position: relative;
    z-index: 1;
    padding-top: 5rem;
  }

  @media (max-width: 800px) {
    .hero-intro {
      min-height: 100svh;
      align-items: start;
      padding-top: 11vh;
    }

    .hero-copy {
      width: min(88vw, 32rem);
      margin: 0;
      text-align: center;
    }

    .hero-copy h1 {
      font-size: clamp(2.35rem, 11vw, 4rem);
    }

    .hero-subtitle {
      margin: 1rem 0 1.25rem;
    }

    .hero-character-wrap {
      right: auto;
      bottom: -2rem;
      left: 50%;
      width: min(92vw, 28rem);
      animation: none;
      opacity: 0.24;
      transform: translateX(-50%);
    }

    .hero-hint {
      bottom: 0.9rem;
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-glow,
    .hero-copy,
    .hero-character-wrap,
    .hero-character,
    .hero-character-halo,
    .hero-particles span,
    .hero-hint span {
      animation: none;
    }
  }

  @keyframes hero-copy-in {
    from { opacity: 0; transform: translateY(22px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes hero-character-in {
    from { opacity: 0; transform: translate3d(4rem, 2rem, 0) scale(0.96); }
    to { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
  }

  @keyframes hero-breathe {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-8px) scale(1.012); }
  }

  @keyframes hero-float {
    0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(12px, -18px, 0) scale(1.08); }
  }

  @keyframes hero-particle {
    0%, 100% { opacity: 0.15; transform: translateY(0) scale(0.7); }
    50% { opacity: 0.9; transform: translateY(-22px) scale(1.25); }
  }

  @keyframes hero-arrow {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(5px); }
  }

  @keyframes hero-ring {
    0%, 100% { transform: scale(0.96) rotate(0deg); opacity: 0.45; }
    50% { transform: scale(1.04) rotate(12deg); opacity: 1; }
  }

  @keyframes hero-ripple {
    from { opacity: 0.9; transform: translate(-50%, -50%) scale(1); }
    to { opacity: 0; transform: translate(-50%, -50%) scale(26); }
  }

  @keyframes hero-spark {
    0% { opacity: 0; transform: translate(-50%, -50%) scale(0.2); }
    18% { opacity: 1; }
    100% { opacity: 0; transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(0.05); }
  }

  :global(body.home-intro-active #live2d-mobile-toggle),
  :global(body.home-intro-active #live2d-widget),
  :global(body.home-intro-active #live2d-chat) {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }

  /* 纯动态封面：不依赖图片素材 */
  .hero-intro {
    min-height: 100svh;
    background: #f7f8fa;
    color: #0a0b0e;
    overflow: clip;
  }

  .hero-intro::before {
    background:
      radial-gradient(circle at 50% 48%, rgb(255 255 255 / 98%) 0 19%, transparent 48%),
      radial-gradient(circle at 12% 20%, rgb(183 213 235 / 19%), transparent 29%),
      radial-gradient(circle at 88% 72%, rgb(210 197 246 / 19%), transparent 32%),
      #f7f8fa;
  }

  .hero-grid {
    inset: 0;
    opacity: 0.55;
    background-size: 58px 58px;
    transform: none;
    mask-image: linear-gradient(to bottom, transparent 0%, #000 14%, #000 86%, transparent 100%);
  }

  .hero-vignette {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse at center, transparent 32%, rgb(247 248 250 / 48%) 84%);
    pointer-events: none;
  }

  .hero-equations span {
    position: absolute;
    top: var(--y);
    left: var(--x);
    color: rgb(126 177 211 / 17%);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: clamp(0.78rem, 1.1vw, 1rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    white-space: nowrap;
    animation: equation-drift 11s var(--d) ease-in-out infinite;
  }

  .hero-network {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero-network-lines path {
    fill: none;
    stroke: rgb(135 126 213 / 28%);
    stroke-width: 1.2;
    stroke-dasharray: 2 8;
    animation: network-flow 8s linear infinite;
  }

  .hero-network-lines path:nth-child(2) { stroke: rgb(129 154 213 / 22%); animation-delay: -3s; }
  .hero-network-points circle {
    fill: #a99de3;
    opacity: 0.62;
    animation: node-pulse 3s ease-in-out infinite;
  }

  .hero-network-points circle:nth-child(2n) { animation-delay: -1.2s; }
  .hero-network-points circle:nth-child(3n) { animation-delay: -2.2s; }

  .hero-orbit {
    position: absolute;
    top: 50%;
    left: 50%;
    border: 1px solid rgb(127 137 195 / 18%);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .hero-orbit-one { width: min(92vw, 80rem); height: min(92vw, 80rem); animation: orbit-spin 28s linear infinite; }
  .hero-orbit-two { width: min(66vw, 56rem); height: min(66vw, 56rem); border-color: rgb(107 174 211 / 20%); animation: orbit-spin 21s linear infinite reverse; }
  .hero-orbit-three { width: min(42vw, 34rem); height: min(42vw, 34rem); border-style: dashed; border-color: rgb(165 145 224 / 24%); animation: orbit-spin 15s linear infinite; }

  .hero-dust i {
    position: absolute;
    top: calc((var(--i) * 29) % 94 * 1%);
    left: calc((var(--i) * 47) % 96 * 1%);
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #a29bd4;
    box-shadow: 0 0 12px 3px rgb(162 155 212 / 40%);
    animation: dust-float 6s calc(var(--i) * -0.25s) ease-in-out infinite;
  }

  .hero-split-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    z-index: 1;
    width: 1px;
    background: linear-gradient(to bottom, transparent, rgb(76 112 157 / 72%) 26%, #111 50%, rgb(76 112 157 / 72%) 74%, transparent);
    box-shadow: 0 0 15px rgb(113 164 202 / 42%);
    transform: translateX(-50%) scaleY(0.22);
    transform-origin: center;
    animation: split-line-breathe 4s ease-in-out infinite;
  }

  .hero-split-line::before,
  .hero-split-line::after {
    position: absolute;
    left: 50%;
    width: 13px;
    height: 13px;
    border: 1px solid rgb(106 144 181 / 70%);
    border-radius: 50%;
    background: #f7f8fa;
    content: '';
    transform: translateX(-50%);
  }

  .hero-split-line::before { top: 50%; }
  .hero-split-line::after { top: calc(50% - 1px); opacity: 0.25; filter: blur(5px); }

  .hero-copy {
    position: relative;
    z-index: 3;
    width: min(92vw, 62rem);
    animation: hero-copy-in 1.4s 0.15s both cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hero-kicker {
    color: #7091a9;
    font-size: 0.7rem;
    letter-spacing: 0.34em;
  }

  .hero-copy h1 {
    color: #08090c;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(3.3rem, 8.8vw, 8.6rem);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.08em;
    text-shadow: 0 1px 0 #fff, 0 15px 40px rgb(39 60 81 / 9%);
  }

  .hero-copy h1 em {
    color: #08090c;
    font-style: normal;
  }

  .hero-subtitle {
    margin: 1.8rem 0 1.7rem;
    color: #555861;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.05rem, 1.9vw, 1.55rem);
    letter-spacing: 0.1em;
  }

  .hero-enter {
    position: relative;
    z-index: 4;
    width: 4.8rem;
    height: 4.8rem;
    justify-content: center;
    padding: 0;
    border: 1px solid rgb(103 137 166 / 24%);
    background: rgb(255 255 255 / 45%);
    color: #52728c;
    box-shadow: 0 0 0 8px rgb(255 255 255 / 35%), 0 14px 28px rgb(62 99 125 / 14%);
  }

  .hero-enter-label { position: absolute; overflow: hidden; width: 1px; height: 1px; clip: rect(0 0 0 0); }
  .hero-enter-arrow { width: 2.3rem; height: 2.3rem; background: transparent; color: #6388a2; font-size: 1.8rem; }

  .hero-hint {
    bottom: 1.5rem;
    color: #76808b;
    font-size: 0.62rem;
    letter-spacing: 0.24em;
  }

  .hero-curtain {
    position: absolute;
    inset: 0 auto 0 0;
    z-index: 2;
    width: 50%;
    background: linear-gradient(90deg, rgb(247 248 250 / 28%), rgb(247 248 250 / 5%));
    backdrop-filter: blur(1px);
    pointer-events: none;
    transition: transform 1.1s cubic-bezier(0.76, 0, 0.24, 1);
  }

  .hero-curtain-right { right: 0; left: auto; background: linear-gradient(270deg, rgb(247 248 250 / 28%), rgb(247 248 250 / 5%)); }
  .hero-intro[data-revealed] .hero-curtain-left { transform: translateX(-101%); }
  .hero-intro[data-revealed] .hero-curtain-right { transform: translateX(101%); }
  .hero-intro[data-revealed] .hero-split-line { animation: split-open 1.1s cubic-bezier(0.76, 0, 0.24, 1) forwards; }
  .hero-intro[data-revealed] .hero-copy { opacity: 0; transform: scale(1.06); transition: opacity 500ms ease, transform 900ms ease; }

  @keyframes equation-drift { 0%, 100% { opacity: 0.45; transform: translate3d(0, 0, 0); } 50% { opacity: 1; transform: translate3d(12px, -8px, 0); } }
  @keyframes network-flow { to { stroke-dashoffset: -160; } }
  @keyframes node-pulse { 0%, 100% { opacity: 0.3; transform: scale(0.75); transform-origin: center; } 50% { opacity: 0.9; transform: scale(1.5); transform-origin: center; } }
  @keyframes orbit-spin { to { transform: translate(-50%, -50%) rotate(360deg); } }
  @keyframes dust-float { 0%, 100% { opacity: 0.15; transform: translateY(0); } 50% { opacity: 0.9; transform: translateY(-18px); } }
  @keyframes split-line-breathe { 0%, 100% { opacity: 0.62; transform: translateX(-50%) scaleY(0.22); } 50% { opacity: 1; transform: translateX(-50%) scaleY(0.9); } }
  @keyframes split-open { to { opacity: 0; transform: translateX(-50%) scaleY(0); } }

  .hero-click-spark { z-index: 9; background: #8e82cc; box-shadow: 0 0 12px 3px rgb(142 130 204 / 70%); }

  @media (max-width: 800px) {
    .hero-copy { width: min(94vw, 35rem); }
    .hero-copy h1 { font-size: clamp(3rem, 15vw, 5.1rem); }
    .hero-subtitle { font-size: 1rem; letter-spacing: 0.04em; }
    .hero-orbit-one { width: 140vw; height: 140vw; }
    .hero-orbit-two { width: 100vw; height: 100vw; }
    .hero-orbit-three { width: 68vw; height: 68vw; }
    .hero-equations span { font-size: 0.62rem; }
    .hero-network { height: 78%; top: 11%; }
  }
</style>

<script>
  const hero = document.getElementById('hero-intro')
  const enter = document.getElementById('hero-enter')
  const content = document.getElementById('content-header')

  let revealing = false

  const burst = (event: MouseEvent) => {
    if (!hero) return
    hero.style.setProperty('--ripple-x', `${event.clientX}px`)
    hero.style.setProperty('--ripple-y', `${event.clientY}px`)
    hero.setAttribute('data-ripple', `${Date.now()}`)
    window.setTimeout(() => hero.removeAttribute('data-ripple'), 900)
    for (let i = 0; i < 16; i += 1) {
      const spark = document.createElement('i')
      spark.className = 'hero-click-spark'
      spark.style.setProperty('--dx', `${Math.cos((Math.PI * 2 * i) / 16) * (45 + Math.random() * 80)}px`)
      spark.style.setProperty('--dy', `${Math.sin((Math.PI * 2 * i) / 16) * (45 + Math.random() * 80)}px`)
      spark.style.left = `${event.clientX}px`
      spark.style.top = `${event.clientY}px`
      hero.appendChild(spark)
      window.setTimeout(() => spark.remove(), 800)
    }
  }

  hero?.addEventListener('click', (event) => burst(event as MouseEvent))

  const reveal = (x = window.innerWidth / 2, y = window.innerHeight / 2) => {
    if (!hero || revealing) return
    revealing = true
    hero.style.setProperty('--ripple-x', `${x}px`)
    hero.style.setProperty('--ripple-y', `${y}px`)
    hero.setAttribute('data-ripple', `${Date.now()}`)
    hero.setAttribute('data-revealed', '')
    window.setTimeout(() => {
      content?.scrollIntoView({ behavior: 'smooth', block: 'start' })
      window.setTimeout(() => { revealing = false }, 900)
    }, 420)
  }

  enter?.addEventListener('click', () => {
    reveal()
  })

  hero?.addEventListener('wheel', (event) => {
    if (event.deltaY > 0 && window.scrollY < window.innerHeight * 0.18) {
      event.preventDefault()
      reveal(event.clientX, event.clientY)
    }
  }, { passive: false })

  const updateHero = () => {
    const revealed = window.scrollY > window.innerHeight * 0.18
    hero?.toggleAttribute('data-revealed', revealed)
    document.body.classList.toggle('home-intro-active', !revealed)
  }

  updateHero()
  window.addEventListener('scroll', updateHero, { passive: true })
</script>
