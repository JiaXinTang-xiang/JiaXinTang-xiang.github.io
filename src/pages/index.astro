            <Icon name='github' class='size-5' slot='icon' />
          </Label>
          <Label title='Email' as='a' href='mailto:2174064279@qq.com' target='_blank'>
            <Icon name='email' class='size-5' slot='icon' />
          </Label>
        </div>
      </div>

