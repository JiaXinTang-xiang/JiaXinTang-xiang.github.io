        <path d='M0 470 L270 478 L520 468 L812 475 L1090 472 L1440 468' />
        <path d='M145 430 L270 478 L392 438 L520 468 L672 442 L812 475 L956 433 L1090 472 L1248 438' />
      </g>
      <g class='hero-network-points'>
        <circle cx='145' cy='430' r='4' /><circle cx='270' cy='478' r='5' />
        <circle cx='392' cy='438' r='3' /><circle cx='520' cy='468' r='5' />
        <circle cx='672' cy='442' r='4' /><circle cx='812' cy='475' r='5' />
