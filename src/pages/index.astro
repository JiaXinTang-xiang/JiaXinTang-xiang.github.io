---
import { getCollection, type CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'

import { Quote } from 'astro-pure/advanced'
import { sortMDByDate } from 'astro-pure/server'
import { Button, Card, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import ProjectCard from '@/components/home/ProjectCard.astro'
import Section from '@/components/home/Section.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import config from '@/site-config'

const languages = ['HTML', 'CSS', 'JavaScript', 'TypeScript']
const frontend = ['React', 'Vue.js', 'Astro', 'Tailwind CSS']
const backend = ['Node.js', 'Express', 'MongoDB', 'Vercel']

type HomeCollection = 'blog' | 'tech' | 'daily' | 'monthly'
type HomePost = CollectionEntry<HomeCollection>

const posts = (
  await Promise.all(
    (['blog', 'tech', 'daily', 'monthly'] as HomeCollection[]).map((collection) =>
      getCollection(collection, ({ data }) => !data.draft)
    )
  )
).flat() as unknown as HomePost[]
const fixedPostId = 'tools/about-ubuntu-command'
const now = new Date()
const postPath = (post: HomePost) => `/${post.collection}/${post.id}`
const postDate = (post: HomePost) => post.data.updatedDate ?? post.data.publishDate
const formatPostDate = (post: HomePost) => {
  const date = postDate(post)
  return `${date.getFullYear()}年${date.getMonth() + 1}月${date.getDate()}日`
}
const latestPosts: HomePost[] = sortMDByDate(posts)
  .filter((post) => post.id !== fixedPostId && postDate(post) <= now)
  .slice(0, 5) as HomePost[]
const fixedPost: HomePost | undefined = posts.find((post) => post.id === fixedPostId)

const imagePath = config.logo.src
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)
if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,avif,webp}"`
  )
