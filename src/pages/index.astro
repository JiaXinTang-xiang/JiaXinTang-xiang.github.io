---
import { getCollection, type CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'

import { Quote } from 'astro-pure/advanced'
import { sortMDByDate } from 'astro-pure/server'
import { Button, Card, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import ProjectCard from '@/components/home/ProjectCard.astro'
import Section from '@/components/home/Section.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import config from '@/site-config'

const languages = ['HTML', 'CSS', 'JavaScript', 'TypeScript']
const frontend = ['React', 'Vue.js', 'Astro', 'Tailwind CSS']
const backend = ['Node.js', 'Express', 'MongoDB', 'Vercel']

type HomeCollection = 'blog' | 'tech' | 'daily' | 'monthly'
type HomePost = CollectionEntry<HomeCollection>

const posts = (
  await Promise.all(
    (['blog', 'tech', 'daily', 'monthly'] as HomeCollection[]).map((collection) =>
      getCollection(collection, ({ data }) => !data.draft)
    )
  )
).flat() as unknown as HomePost[]
const fixedPostId = 'tools/about-ubuntu-command'
const now = new Date()
const postPath = (post: HomePost) => `/${post.collection}/${post.id}`
const postDate = (post: HomePost) => post.data.updatedDate ?? post.data.publishDate
const formatPostDate = (post: HomePost) => {
  const date = postDate(post)
  return `${date.getFullYear()}年${date.getMonth() + 1}月${date.getDate()}日`
}
const latestPosts: HomePost[] = sortMDByDate(posts)
  .filter((post) => post.id !== fixedPostId && postDate(post) <= now)
  .slice(0, 5) as HomePost[]
const fixedPost: HomePost | undefined = posts.find((post) => post.id === fixedPostId)

const imagePath = config.logo.src
const heroImagePath = '/src/assets/home-hero-character.png'
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)
if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,avif,webp}"`
  )
if (!images[heroImagePath]) throw new Error(`"${heroImagePath}" does not exist in glob`)
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#659EB9'>
  <section class='hero-intro' id='hero-intro' aria-label='首页动态封面'>
    <div class='hero-grid' aria-hidden='true'></div>
    <div class='hero-glow hero-glow-one' aria-hidden='true'></div>
    <div class='hero-glow hero-glow-two' aria-hidden='true'></div>
    <div class='hero-particles' aria-hidden='true'>
      {Array.from({ length: 18 }).map((_, index) => <span style={`--i:${index}`}></span>)}
    </div>
    <div class='hero-copy'>
      <p class='hero-kicker'>JIABLOG · PERSONAL SPACE</p>
      <h1>欢迎来到<br /><em>我的博客</em></h1>
      <p class='hero-subtitle'>记录技术、生活与那些正在发生的思考。</p>
      <button class='hero-enter' id='hero-enter' type='button'>
        <span>进入博客</span>
        <span class='hero-enter-arrow' aria-hidden='true'>↓</span>
      </button>
    </div>
    <div class='hero-character-wrap' aria-hidden='true'>
      <div class='hero-character-halo'></div>
      <Image
        src={images[heroImagePath]()}
        alt='蓝发动漫角色'
        class='hero-character'
        loading='eager'
        fetchpriority='high'
      />
    </div>
    <div class='hero-rings' aria-hidden='true'>
      <span></span><span></span><span></span>
    </div>
    <p class='hero-hint'>向下滚动探索 <span>↓</span></p>
