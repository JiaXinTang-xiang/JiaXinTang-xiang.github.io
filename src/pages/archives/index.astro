---
import { getCollection, type CollectionEntry } from 'astro:content'
import PageLayout from '@/layouts/CommonPage.astro'
type K = 'blog' | 'tech' | 'daily' | 'monthly'
type E = CollectionEntry<K>
const entries = (await Promise.all((['blog', 'tech', 'daily', 'monthly'] as K[]).map((c) => getCollection(c, ({ data }) => !data.draft)))).flat() as E[]
const grouped = new Map<string, E[]>()
for (const e of entries) {
  const d = e.data.updatedDate ?? e.data.publishDate
  if (!d) continue
  const k = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`
  grouped.set(k, [...(grouped.get(k) ?? []), e])
}
const groups = [...grouped.entries()].sort(([a], [b]) => b.localeCompare(a))
const headings = groups.map(([k]) => ({ depth: 2, slug: `archive-${k}`, text: `${k.slice(0, 4)}年${k.slice(5)}月` }))
const path = (e: E) => `/${e.collection}/${e.id}`
---
<PageLayout title='文章归档' {headings}>
  <div class='space-y-8'>
    {groups.map(([key, list]) => {
      const [year, month] = key.split('-')
      const sorted = list.sort((a, b) => (b.data.updatedDate ?? b.data.publishDate).valueOf() - (a.data.updatedDate ?? a.data.publishDate).valueOf())
      return <section aria-labelledby={`archive-${key}`}>
        <h2 id={`archive-${key}`} class='mb-3 text-xl font-semibold'>{year}年{month}月</h2>
        <ul class='space-y-2 border-l pl-5'>
          {sorted.map((e) => { const d = e.data.updatedDate ?? e.data.publishDate; return <li class='flex flex-wrap items-baseline gap-x-3'><time class='text-sm tabular-nums text-muted-foreground' datetime={d.toISOString()}>{String(d.getMonth() + 1).padStart(2, '0')}/{String(d.getDate()).padStart(2, '0')}</time><a href={path(e)} class='hover:text-primary hover:underline'>{e.data.title}</a></li> })}
        </ul>
      </section>
    })}
  </div>
</PageLayout>
